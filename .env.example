# ─────────────────────────────────────────────
# SANITY CMS
# Get these from sanity.io → your project → API
# ─────────────────────────────────────────────
# Project ID uses only a-z, 0-9, and dashes (no underscores)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API token — create at sanity.io → API → Tokens
# Give it "Editor" permissions so Next.js can read draft content
SANITY_API_TOKEN=your_token_here

# ─────────────────────────────────────────────
# GOOGLE ANALYTICS 4
# Get from GA4 → Admin → Data Streams → Web stream
# Looks like: G-XXXXXXXXXX
# ─────────────────────────────────────────────
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────────
# SITE
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://morajgroup.com
